# OneMap API access token (valid for three days)
ONEMAP_ACCESS_TOKEN=your-onemap-access-token

# LTA DataMall Account Key
LTA_DATAMALL_ACCOUNT_KEY=your-lta-datamall-account-key

# LTA Station Exits GeoJSON URL
LTA_STATION_EXITS_GEOJSON_URL=https://api-open.data.gov.sg/v1/public/api/datasets/d_b39d3a0871985372d7e1637193335da5/poll-download

# CartoDB API Key (optional for higher rate limits)
CARTODB_API_KEY=your-cartodb-api-key
VITE_CARTODB_API_KEY=your-cartodb-api-key
