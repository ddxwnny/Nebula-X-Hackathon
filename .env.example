# ==========================================
# sMaRT Move - Environment Configuration
# ==========================================

# [REQUIRED FOR ROUTING] OneMap Access Token
# Required to plan transit journeys via OneMap Routing APIs.
# Obtain a free token from https://www.onemap.gov.sg/apidocs/
ONEMAP_ACCESS_TOKEN=your-onemap-access-token

# (Alternative) If you prefer automatic token renewal, set your OneMap credentials instead:
# ONEMAP_EMAIL=your-onemap-email@example.com
# ONEMAP_PASSWORD=your-onemap-password

# [RECOMMENDED] LTA DataMall Account Key
# Enables real-time train service alerts, disruption monitoring, and live bus arrivals.
# Request a free API key at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_DATAMALL_ACCOUNT_KEY=your-datamall-account-key

# [OPTIONAL] Official LTA Station Exits Dataset URL
# Pre-configured to data.gov.sg LTA station exits by default. Override only if using a custom mirror.
# LTA_STATION_EXITS_GEOJSON_URL=https://api-open.data.gov.sg/v1/public/api/datasets/d_b39d3a0871985372d7e1637193335da5/poll-download